<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resumen Diario</title>
    <!-- Importar fuentes similares a la landing page -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">
    <link href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: transparent;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        .container {
            width: 560px;
            background-color: #09090b;
            color: #ffffff;
            padding: 40px;
            border-radius: 40px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-sizing: border-box;
        }

        /* Ambient glow effect */
        .container::before {
            content: "";
            position: absolute;
            top: -20%;
            left: -10%;
            width: 120%;
            height: 60%;
            background: radial-gradient(60% 100% at 50% 0%, rgba(168, 85, 247, 0.15), rgba(255,255,255,0) 60%);
            filter: blur(40px);
            opacity: 0.8;
            pointer-events: none;
            z-index: 0;
        }

        .liquid-glass-highlight-top {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            opacity: 0.5;
        }

        .liquid-glass-highlight-bottom {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            opacity: 0.3;
        }

        .card {
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            position: relative;
            z-index: 10;
            overflow: hidden;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
        }

        .header h1 {
            margin: 0;
            font-family: 'Playfair Display', serif;
            font-size: 42px;
            color: #ffffff;
            font-weight: 600;
            background: linear-gradient(to right, #ffffff, #e9d5ff, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.02em;
        }

        .header p {
            margin: 12px 0 0 0;
            color: #a1a1aa;
            font-size: 16px;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }

        .total-box {
            background: linear-gradient(to bottom, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 24px;
            padding: 30px;
            text-align: center;
            margin-bottom: 25px;
            position: relative;
            overflow: hidden;
            box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.2);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }

        .total-box h2 {
            margin: 0;
            font-size: 12px;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            font-weight: 700;
        }

        .total-amount {
            font-family: 'Clash Display', sans-serif;
            font-size: 56px;
            font-weight: 600;
            color: #ffffff;
            margin: 10px 0 0 0;
            line-height: 1;
            text-shadow: 0 0 30px rgba(168, 85, 247, 0.4);
            display: flex;
            align-items: baseline;
            justify-content: center;
            gap: 12px;
        }

        .total-amount span.currency-label {
            font-size: 24px;
            color: #a855f7;
            font-weight: 500;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 20px;
            text-align: left;
        }

        .stat-card h3 {
            margin: 0;
            font-size: 11px;
            color: #a1a1aa;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }

        .stat-card .value {
            font-family: 'Clash Display', sans-serif;
            font-size: 24px;
            font-weight: 600;
            margin-top: 8px;
        }

        .stat-card .footer-text {
            font-size: 10px;
            color: #71717a;
            margin-top: 6px;
            display: block;
        }

        .value.income { color: #4ade80; }
        .value.expense { color: #fb7185; }

        .comparison-badge {
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 700;
            margin-left: 5px;
            display: inline-block;
            vertical-align: middle;
        }
        .badge-up { background: rgba(251, 113, 133, 0.15); color: #fb7185; }
        .badge-down { background: rgba(74, 222, 128, 0.15); color: #4ade80; }

        .projection-box {
            background: rgba(168, 85, 247, 0.05);
            border: 1px dashed rgba(168, 85, 247, 0.3);
            border-radius: 16px;
            padding: 15px;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .projection-info h4 {
            margin: 0;
            font-size: 11px;
            color: #a855f7;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .projection-info p {
            margin: 4px 0 0 0;
            font-size: 13px;
            color: #d4d4d8;
        }

        .projection-value {
            font-family: 'Clash Display', sans-serif;
            font-size: 20px;
            font-weight: 600;
            color: #ffffff;
        }

        .ant-summary {
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(255, 255, 255, 0.03);
            padding: 12px 20px;
            border-radius: 14px;
            margin-bottom: 25px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .ant-summary span { font-size: 18px; }
        .ant-summary p { margin: 0; font-size: 12px; color: #a1a1aa; }
        .ant-summary b { color: #ffffff; }

        .pending-bar {
            background: rgba(245, 158, 11, 0.1);
            border: 1px solid rgba(245, 158, 11, 0.2);
            border-radius: 12px;
            padding: 10px 20px;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 12px;
            color: #fcd34d;
        }

        .budget-section {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .budget-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .budget-header h3 {
            margin: 0;
            font-size: 12px;
            color: #a1a1aa;
            text-transform: uppercase;
        }

        .budget-header span {
            font-size: 12px;
            font-weight: 600;
            color: #ffffff;
        }

        .progress-bar {
            width: 100%;
            height: 10px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 5px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #a855f7, #6366f1);
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
        }

        .savings-section {
            margin-bottom: 25px;
        }

        .savings-title {
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: #a1a1aa;
            margin-bottom: 15px;
            font-weight: 700;
        }

        .savings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .saving-item {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 15px;
        }

        .saving-name {
            font-size: 13px;
            font-weight: 600;
            color: #e4e4e7;
            margin-bottom: 8px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .saving-progress {
            font-size: 11px;
            color: #a1a1aa;
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
        }

        .daily-section {
            background: linear-gradient(to bottom, rgba(168, 85, 247, 0.1), rgba(0, 0, 0, 0));
            border: 1px solid rgba(168, 85, 247, 0.2);
            border-radius: 24px;
            padding: 25px;
            margin-bottom: 25px;
        }

        .daily-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .daily-header h3 {
            margin: 0;
            font-size: 14px;
            color: #ffffff;
            font-weight: 700;
        }

        .daily-amount {
            font-family: 'Clash Display', sans-serif;
            font-size: 24px;
            font-weight: 600;
            color: #ffffff;
        }

        .no-expense-msg {
            text-align: center;
            padding: 10px 0;
        }

        .no-expense-msg span {
            font-size: 32px;
            display: block;
            margin-bottom: 10px;
        }

        .no-expense-msg p {
            margin: 0;
            color: #a855f7;
            font-weight: 600;
            font-size: 16px;
        }

        .bar-row {
            margin-bottom: 12px;
        }

        .bar-label {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 13px;
            color: #d4d4d8;
        }

        .bar-bg {
            height: 6px;
        }

        .tip-box {
            padding: 20px;
        }
        
        .footer-brand {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 24px;
            z-index: 10;
        }

        .footer-logo {
            width: 80px;
            height: 80px;
            object-fit: contain;
            opacity: 0.9;
            filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.3));
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <!-- Liquid Glass Highlights -->
            <div class="liquid-glass-highlight-top"></div>
            <div class="liquid-glass-highlight-bottom"></div>

            <div class="header">
                <h1>Resumen Diario</h1>
                <p><%= date %></p>
            </div>

            <div class="total-box">
                <h2>Balance Total</h2>
                <div class="total-amount">
                    <span class="currency-label"><%= currency %></span>
                    <%= totalBalance.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </div>
            </div>

            <div class="stats-grid">
                <div class="stat-card">
                    <h3>Ingresos Mes</h3>
                    <div class="value income"><%= currency %> <%= monthlyIncome.toLocaleString('es-PE', { minimumFractionDigits: 2 }) %></div>
                </div>
                <div class="stat-card">
                    <h3>Gastos Mes 
                        <% if (weeklyComparison !== 0) { %>
                            <span class="comparison-badge <%= weeklyComparison > 0 ? 'badge-up' : 'badge-down' %>">
                                <%= weeklyComparison > 0 ? '▲' : '▼' %> <%= Math.abs(weeklyComparison).toFixed(0) %>%
                            </span>
                        <% } %>
                    </h3>
                    <div class="value expense"><%= currency %> <%= monthlyExpense.toLocaleString('es-PE', { minimumFractionDigits: 2 }) %></div>
                    <span class="footer-text">vs semana pasada</span>
                </div>
            </div>

            <div class="projection-box">
                <div class="projection-info">
                    <h4>Proyección Fin de Mes</h4>
                    <p>Basado en tu ritmo de gasto actual</p>
                </div>
                <div class="projection-value"><%= currency %> <%= projectedExpense.toLocaleString('es-PE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></div>
            </div>

            <% if (antCount > 0) { %>
            <div class="ant-summary">
                <span>🐜</span>
                <p>Llevas <b><%= antCount %> gastos hormiga</b> este mes, sumando <b><%= currency %> <%= antTotal.toFixed(2) %></b>. ¡Cuidado con los pequeños consumos!</p>
            </div>
            <% } %>

            <% if (pendingCount > 0) { %>
            <div class="pending-bar">
                <span>🔔</span>
                Tienes <b><%= pendingCount %> gastos pendientes</b> por revisar en tu dashboard.
            </div>
            <% } %>

            <% if (budgetAmount > 0) { %>
            <div class="budget-section">
                <div class="budget-header">
                    <h3>Presupuesto Mensual</h3>
                    <span><%= ((monthlyExpense / budgetAmount) * 100).toFixed(0) %>% consumido</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" style="width: <%= Math.min((monthlyExpense / budgetAmount) * 100, 100) %>%"></div>
                </div>
            </div>
            <% } %>

            <% if (savingsGoals.length > 0) { %>
            <div class="savings-section">
                <div class="savings-title">Tus Ahorros</div>
                <div class="savings-grid">
                    <% savingsGoals.forEach(function(goal) { %>
                    <div class="saving-item">
                        <div class="saving-name"><%= goal.name %></div>
                        <div class="saving-progress">
                            <span><%= goal.percentage.toFixed(0) %>%</span>
                            <span><%= currency %> <%= goal.current.toLocaleString('es-PE') %></span>
                        </div>
                        <div class="progress-bar" style="height: 4px;">
                            <div class="progress-fill" style="width: <%= Math.min(goal.percentage, 100) %>%"></div>
                        </div>
                    </div>
                    <% }); %>
                </div>
            </div>
            <% } %>

            <div class="daily-section">
                <div class="daily-header">
                    <h3>Resumen de Hoy</h3>
                    <% if (totalAmount > 0) { %>
                    <div class="daily-amount"><%= currency %> <%= totalAmount.toFixed(2) %></div>
                    <% } %>
                </div>

                <% if (totalAmount > 0) { %>
                    <% categories.forEach(function(cat) { %>
                    <div class="bar-row">
                        <div class="bar-label">
                            <span><%= cat.name %></span>
                            <span><%= currency %> <%= cat.amount.toFixed(2) %></span>
                        </div>
                        <div class="bar-bg">
                            <div class="bar-fill" style="width: <%= cat.percentage %>%;"></div>
                        </div>
                    </div>
                    <% }); %>
                <% } else { %>
                    <div class="no-expense-msg">
                        <span>🚀</span>
                        <p>¡Día de Ahorro Perfecto!</p>
                        <p style="font-size: 13px; color: #a1a1aa; font-weight: 400; margin-top: 5px;">No registraste gastos hoy.</p>
                    </div>
                <% } %>
            </div>

            <div class="tip-box">
                <div class="tip-icon">💡</div>
                <div class="tip-content">
                    <h4>Tip del Día</h4>
                    <p><%= tip %></p>
                </div>
            </div>
        </div>
        <div class="footer-brand">
            <img src="<%= logoBase64 %>" alt="ContaPRO Logo" class="footer-logo" />
        </div>
    </div>
</body>
</html>